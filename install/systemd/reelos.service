[Unit]
Description=ReelOS shell
After=network-online.target docker.service reelos-firstboot.service
Wants=network-online.target
RequiresMountsFor=/opt/reelos/app

[Service]
Type=simple
WorkingDirectory=/opt/reelos/app
Environment=REELOS_APPLIANCE=1
Environment=REELOS_ROOT=/opt/reelos
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start:box
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
