#cloud-config
# ReelOS Ubuntu autoinstall. Keys never belong in this file.
# TorBox API key and wizard admin PIN are typed on first boot, not baked.
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: UTC
  refresh-installer:
    update: false
  updates: none
  apt:
    fallback: offline-install
  identity:
    hostname: reelos
    username: reelos
    password: '$6$dTG7jXc7/PdyOZp5$/GLYde1iiJMYlB3fINRjsdrWLOS4YwEspcvTZK/7XhrpS3dQnhBH.8Cs5nb8VbCorWc3aE/kSxDIidPtJsP.M.'
  ssh:
    allow-pw: true
    install-server: true
  storage:
    layout:
      name: direct
  network:
    version: 2
    ethernets:
      all-en:
        match:
          name: en*
        dhcp4: true
      all-eth:
        match:
          name: eth*
        dhcp4: true
  early-commands:
    - /bin/bash /cdrom/nocloud/live-wifi.sh || true
  late-commands:
    - mkdir -p /target/opt/reelos /target/var/lib/reelos /target/etc/systemd/system /target/opt/reelos/bin /target/opt/reelos/seed
    - cp -a /cdrom/nocloud/. /target/opt/reelos/seed/ || true
    - chmod 755 /target/opt/reelos/seed/seed-reelos.sh /target/opt/reelos/seed/late.sh /target/opt/reelos/seed/live-wifi.sh || true
    - rm -f /target/etc/resolv.conf
    - printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' > /target/etc/resolv.conf
    - dpkg --root=/target -i /cdrom/pool/main/libn/libnl3/libnl-3-200_*.deb /cdrom/pool/main/libn/libnl3/libnl-genl-3-200_*.deb /cdrom/pool/main/w/wpa/wpasupplicant_*.deb || true
    - curtin in-target -- bash /opt/reelos/seed/late.sh
  shutdown: reboot
