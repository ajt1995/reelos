{
	auto_https off
	admin off
}
:80 {
	encode gzip
	# Door restart: node :8080 is down. Do not let Chrome paint a 502.
	handle_errors {
		@updating `{err.status_code} == 502 || {err.status_code} == 503`
		handle @updating {
			header Content-Type "text/html; charset=utf-8"
			respond <<HTML
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><title>Updating ReelOS</title>
<meta name="viewport" content="width=device-width, initial-scale=1"></head>
<body style="margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0B0D10;color:#e8e6e3;font-family:sans-serif">
<p style="letter-spacing:.34em;text-transform:uppercase;color:#d4a017">Updating ReelOS…</p>
</body>
</html>
HTML 200
		}
	}
	# Jellyfin Watch is :8096. /play/$id is the ReelOS shell player — do not steal it.
	handle /advanced/downloads* {
		uri strip_prefix /advanced/downloads
		reverse_proxy 127.0.0.1:8282
	}
	handle /kavita* {
		reverse_proxy 127.0.0.1:5000
	}
	handle /seerr* {
		reverse_proxy 127.0.0.1:5055
	}
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
