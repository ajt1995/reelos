# Auto-detect text files and normalize line endings
* text=auto

# Explicit LF enforcement for Linux execution
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.service text eol=lf
*.timer text eol=lf
*.target text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Caddyfile text eol=lf
VERSION text eol=lf
