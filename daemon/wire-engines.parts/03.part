    """Generic Torznab at search-api.torbox.app. Schema optional."""
    impl = {
        "implementation": "Torznab",
        "implementationName": "Torznab",
        "configContract": "TorznabSettings",
        "appProfileId": 1,
        "protocol": "torrent",
