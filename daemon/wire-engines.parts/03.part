        schemas = []
    for schema in schemas if isinstance(schemas, list) else []:
        if str(schema.get("implementation") or "").lower() == "torznab":
            impl = schema
            fields = []
            for f in schema.get("fields") or []:
                item = dict(f)
                n = str(item.get("name") or "").lower()
                if n in ("baseurl", "base_url"):
